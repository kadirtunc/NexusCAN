CM_ "NexusCAN Tam Kapsamli EV Powertrain, CAN-FD, J1939/Extended ve HIL Simulasyon Test Veritabani.";
CM_ BU_ BMS "Yuksek Gerilim Batarya Yonetim Sistemi (800V Li-NMC Paket + 12 Hucre Mux Telemetri)";
CM_ BU_ VCU "Arac Kontrol Unitesi (Surucu Vites, Tork, Rejeneratif Fren ve Acil Durdurma Komutlari)";
CM_ BU_ MCU "Traksiyon Motoru & SiC Evirici Kontrol Unitesi (Motorola Big-Endian + 64B CAN-FD)";
CM_ BU_ OBC "29-bit Extended Yerlesik / Hizli Sarj Kontrol Unitesi (0x18FF50E5)";
CM_ BU_ GNSS "Yuksek Hassasiyetli RTK/GNSS Konumlandirma Dugumu (Harita Widget Testi)";

CM_ BO_ 257 "BMS ana batarya paketi gerilim, akim, SOC ve kontaktor durum mesaji.";
CM_ BO_ 258 "MCU Motorola (Big-Endian) motor devri, tork ve sicaklik telemetrisi.";
CM_ BO_ 261 "4 sayfali (MuxPage 0..3) 12-hucre gerilim izleme multiplexer mesaji.";
CM_ BO_ 517 "64-byte CAN-FD BRS yuksek hizli IEEE-754 Float32/Float64 evirici tanilama cercevesi.";
CM_ BO_ 2566869221 "29-bit Extended ID (0x18FF50E5) sarj cihazi cikis gerilim/akim ve durum mesaji.";
CM_ BO_ 784 "Simulasyon kokpitindeki 5 gelismis buton modu ve tork/fren slider hedef sinyalleri.";
CM_ BO_ 1040 "OpenStreetMap / GNSS harita widget izleme testi icin enlem/boylam telemetrisi.";

CM_ SG_ 257 PackVoltage_V "Ana batarya terminali DC gerilimi (0.1 V cozunurluk).";
CM_ SG_ 257 PackCurrent_A "Paket akimi: pozitif = desarj (ivmelenme), negatif = rejeneratif sarj.";
CM_ SG_ 258 MotorSpeed_RPM "Motorola Big-Endian (@0-) isaretli motor devri.";
CM_ SG_ 517 PhaseCurrentU_A "IEEE-754 32-bit Float U-fazi anlik akimi.";
CM_ SG_ 517 TotalMechanicalEnergy_kWh "IEEE-754 64-bit Double toplam aktarilan mekanik enerji (byte 24..31).";
CM_ SG_ 517 FdCrc8Checksum "64-byte CAN-FD sinir dogrulamasi icin son byte (bit 504..511) CRC8 degeri.";
CM_ SG_ 784 EmergencyLatchCmd "Cift onay kapakli (requireConfirm) Yuksek Gerilim Acil Kesici mandali.";


