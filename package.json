    "test:graph": "esbuild src/components/diagnostics/ecu-graph/graphModel.test.ts --bundle --platform=node --format=esm | node --input-type=module",
    "test:inflight": "esbuild src/services/txInFlight.test.ts --bundle --platform=node --format=esm | node --input-type=module"
