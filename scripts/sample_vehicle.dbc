BO_TX_BU_ 257 : INV,VCU;
BO_TX_BU_ 261 : BMS,VCU;


CM_ "NexusCAN Golden Reference EV Powertrain, SiC Inverter CAN-FD & J1939 DC Fast Charger Database.
Validates Intel (@1+/1-), Vector Motorola Sawtooth (@0+/0-), IEEE-754 Float32/Float64,
64-byte CAN-FD (0..511 bits), Cascaded SG_MUL_VAL_ Multiplexing, and 29-bit J1939 PGN 0xFF50.";
CM_ BU_ VCU "Vehicle Control Unit — Primary torque arbitration, HV sequence coordinator,
and multi-bus gateway supervisor.";
CM_ BU_ INV "800V SiC Traction Inverter — High-rate FOC torque controller supporting
Classical CAN status frames (0x101) and 64-byte CAN-FD fast telemetry (0x201).";
CM_ BU_ BMS "High-Voltage Battery Management System — Pack state estimator, isolation monitor,
and cascaded multiplexer diagnostics publisher (0x105).";
CM_ BU_ OBC "Bidirectional On-Board AC Charger (11kW / 22kW) with V2L support.";
CM_ BU_ DCFC "Off-Board CCS / SAE J1939 DC Fast Charger broadcasting on 29-bit PGN 0xFF50 (SA 0xE5).";

CM_ BO_ 257 "10ms traction inverter primary status frame.
Combines Intel signed/unsigned cross-byte signals with unaligned 3-byte Vector Motorola sawtooth signals.";
CM_ BO_ 261 "20ms BMS cascaded multiplexer diagnostics frame.
Master switch MuxDomainSwitch selects Cell Bank Summary (domains 0..1 -> SubBankSwitch m0M)
or HV Isolation & Contactor diagnostics (domain 2).";
CM_ BO_ 513 "5ms 64-byte Standard CAN-FD high-rate inverter telemetry frame.
Exercises bit offsets 0..511, E2E SIG_GROUP_, IEEE-754 Float32/Float64, and high-byte Motorola sawtooth.";
CM_ BO_ 2566869221 "100ms Extended 29-bit SAE J1939 PGN 65360 (0xFF50) DC fast charger output status.";

CM_ SG_ 257 MotorSpeedRpm "Signed rotor mechanical speed (Intel 16-bit two's complement, 0.5 rpm/lsb).";
CM_ SG_ 257 MotorTorqueNm "Estimated electromagnetic shaft torque.
Encoded as unaligned 16-bit signed Motorola sawtooth spanning bytes 2, 3, and 4 (start bit 19).";
CM_ SG_ 257 DcBusVoltage "Inverter DC-link capacitor voltage (12-bit Motorola cross-byte unsigned).";
CM_ SG_ 257 PhaseCurrentAmp "11-bit signed Intel cross-byte RMS phase current.";
CM_ SG_ 261 MuxDomainSwitch "Top-level multiplexer selector:
0..1 = Cell Bank Sub-Multiplexer, 2 = Isolation & Contactors.";
CM_ SG_ 261 SubBankSwitch "Cascaded sub-multiplexer selector (m0M), active when MuxDomainSwitch is 0..1.";
CM_ SG_ 261 HvInterlockClosed "HVIL loop continuity status; active across domains 2..3 and 10..12 via SG_MUL_VAL_.";
CM_ SG_ 513 FluxLinkageWb "IEEE-754 single-precision float32 rotor flux linkage at bytes 8..11.";
CM_ SG_ 513 TotalEnergyKwh "IEEE-754 double-precision float64 cumulative delivered energy at bytes 16..23.";
CM_ SG_ 513 ShaftTorqueFineNm "High-resolution shaft torque using Motorola sawtooth across CAN-FD bytes 32..34.";
CM_ SG_ 513 TailIntegrityMarker "Final byte 63 marker spanning bits 504..511 to verify 512-bit CAN-FD boundary safety.";
CM_ SG_ 2566869221 ChargerOutputCurrentA "DC output current with J1939 -1000 A offset (raw 10000 = 0.0 A).";


BA_DEF_  "BusType" STRING ;
