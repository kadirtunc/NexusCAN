BA_ "GenSigStartValue" SG_ 2566869221 ChargerOutputCurrentA 10000;
BA_ "GenSigStartValue" SG_ 2566869221 ConnectorTempDegC 65;

BA_ "SystemSignalLongSymbol" SG_ 257 MotorTorqueNm "InverterElectromagneticShaftTorqueEstimatedNm";
BA_ "SystemSignalLongSymbol" SG_ 513 FluxLinkageWb "PermanentMagnetRotorFluxLinkageWebers";
BA_ "SystemSignalLongSymbol" SG_ 513 TotalEnergyKwh "CumulativeInverterNetDeliveredEnergyKilowattHours";
BA_ "SystemSignalLongSymbol" SG_ 513 SiCBridgeTempMaxDegC "SiliconCarbidePowerModuleJunctionTemperatureMaximumDegC";


VAL_ 257 InverterState 0 "Init" 1 "Standby" 2 "Precharge" 3 "TorqueControl" 4 "SpeedControl" 5 "RegenBraking" 6 "ActiveDischarge" 14 "Derating" 15 "FaultLatch" ;
VAL_ 257 DriveGearState 0 "Park" 1 "Reverse" 2 "Neutral" 3 "Drive" 4 "Sport" 15 "SNA" ;
VAL_ 257 ActiveFaultFlag 0 "Normal" 1 "FaultActive" ;
VAL_ 261 ContactorState 0 "AllOpen" 1 "NegClosed_Precharging" 2 "AllClosed_HVActive" 3 "OpeningUnderLoad" 7 "WeldedFault" ;
VAL_ 261 BmsFaultCode 0 "NoFault" 1 "OverCurrent" 2 "OverVoltage" 3 "UnderVoltage" 4 "OverTempIGBT" 5 "OverTempMotor" 6 "ResolverLoss" 7 "WatchdogTimeout" 8 "IsolationFault" ;
VAL_ 261 HvInterlockClosed 0 "Open_Fault" 1 "Closed_OK" ;
VAL_ 2566869221 ChargerOperatingState 0 "NotConnected" 1 "CableCheck" 2 "Precharge" 3 "ConstantCurrent" 4 "ConstantVoltage" 5 "ChargeComplete" 6 "EmergencyShutdown" 7 "ChargerFault" ;
VAL_ 2566869221 CableLockEngaged 0 "Unlocked" 1 "Locked" 2 "ActuatorError" 3 "NotAvailable" ;


SIG_GROUP_ 513 E2E_FastTelemGroup 1 : E2E_Crc16 E2E_AliveCounter E2E_DataId;

SIG_VALTYPE_ 513 FluxLinkageWb : 1;
SIG_VALTYPE_ 513 TotalEnergyKwh : 2;

