SG_MUL_VAL_ 261 CellBank0TempDegC SubBankSwitch 0-0;
SG_MUL_VAL_ 261 CellBank1MinMv SubBankSwitch 1-1;
SG_MUL_VAL_ 261 CellBank1MaxMv SubBankSwitch 1-1;
SG_MUL_VAL_ 261 CellBank1TempDegC SubBankSwitch 1-1;
SG_MUL_VAL_ 261 ContactorState MuxDomainSwitch 2-2;
SG_MUL_VAL_ 261 IsoResistanceKOhm MuxDomainSwitch 2-2;
SG_MUL_VAL_ 261 HvPackVoltageV MuxDomainSwitch 2-2;
SG_MUL_VAL_ 261 BmsFaultCode MuxDomainSwitch 2-2;
SG_MUL_VAL_ 261 HvInterlockClosed MuxDomainSwitch 2-3, 10-12;
